# true|1 = virtual $2 seal (no Stripe charge).
# false|0 = live Stripe Checkout USD $2.00. Missing Stripe keys HARD-FAIL
# (the app will not silently fall back to demo).
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Canonical public URL for Stripe redirects and email links.
# Also accepted as APP_URL. Vercel sets VERCEL_URL as fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Stripe — required when DEMO_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase Postgres (run supabase/migrations/*.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend delivery mail when the open time arrives
RESEND_API_KEY=
RESEND_FROM="약속 <noreply@example.com>"
# Set true if you want Resend to send even while DEMO_MODE=true
DEMO_SEND_EMAIL=false

# Protects /api/cron/deliver (Vercel Cron Authorization bearer)
CRON_SECRET=

# Signs fallback demo tokens. Change in production.
CAPSULE_SIGNING_SECRET=change-me-in-production
