# Set to true to skip Stripe charges and run without paid keys.
# If unset, DEMO_MODE is inferred when Stripe is not configured.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Public site URL (used in email links). Vercel sets VERCEL_URL automatically as fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — $2 seal checkout (required when DEMO_MODE=false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase Postgres (capsules table — see supabase/migrations)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend delivery mail
RESEND_API_KEY=
RESEND_FROM="약속 <noreply@example.com>"

# Protects /api/cron/deliver (Vercel Cron Authorization bearer)
CRON_SECRET=

# Signs demo capsule tokens. Change in production even if DEMO_MODE is on.
CAPSULE_SIGNING_SECRET=change-me-in-production
